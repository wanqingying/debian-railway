<?xml version="1.0" encoding="utf-8"?>
<!--
  SubModule.xml — Bannerlord 模块清单。
  适用：BL 1.5.x / WS 1.3.x（2026-11）。未在任何游戏版本上跑过，仅按文档拼装。

  必读的三条语义：
    1. 文件夹名应与 <Id> 一致；<Id> 不能含空格。
    2. 没有 DLL 的纯数据 mod：<SubModules> 留空 / 整段删掉，合法。
    3. 不同 mod 的同类 XML 会合并；同 id 的对象按加载顺序覆盖（后加载的赢）。
       所以要"改原版装备"就写一个同 id 的对象，要"加装备"就换新 id。
-->
<Module>
    <Name value="My Mod"/>
    <Id value="MyMod"/>
    <Version value="v1.0.0"/>

    <SingleplayerModule value="true"/>
    <MultiplayerModule value="false"/>

    <!-- 官方模块：几乎总要依赖这四个 + StoryMode -->
    <DependedModules>
        <DependedModule Id="Native"/>
        <DependedModule Id="SandBoxCore"/>
        <DependedModule Id="Sandbox"/>
        <DependedModule Id="CustomBattle"/>
        <DependedModule Id="StoryMode"/>
        <!-- 需要 Harmony 时（硬依赖：DLL 不进自己的 bin）：
        <DependedModule Id="Bannerlord.Harmony" DependentVersion="v2.10.1"/>
        -->
    </DependedModules>

    <!-- 纯数据 mod：这一段可以整段删掉 -->
    <SubModules>
        <SubModule>
            <Name value="MyMod"/>
            <!-- 只写文件名，游戏会去 bin/Win64_Shipping_Client 找 -->
            <DLLName value="MyMod.dll"/>
            <!-- 命名空间.类名，必须是 MBSubModuleBase 的子类 -->
            <SubModuleClassType value="MyMod.MySubModule"/>
            <Tags>
                <Tag key="DedicatedServerType" value="none"/>
                <Tag key="IsNoRenderModeElement" value="false"/>
            </Tags>
        </SubModule>
    </SubModules>

    <!-- 注册 ModuleData 下的数据文件；id 是数据类型名，path 不带 .xml -->
    <Xmls>
        <XmlNode>
            <XmlName id="Items" path="mymod_items"/>
        </XmlNode>
        <!--
        <XmlNode>
            <XmlName id="SPCultures" path="mymod_cultures"/>
        </XmlNode>
        <XmlNode>
            <XmlName id="NPCCharacters" path="mymod_characters"/>
        </XmlNode>
        -->
    </Xmls>

    <!-- 可选：BLSE 的社区元数据（关联 Nexus 页面、精细排序）。
         写了要注明依赖 BLSE，否则原版启动器会忽略但玩家可能没装 BLSE。
    <Url value="https://www.nexusmods.com/mountandblade2bannerlord/mods/XXXX"/>
    <DependedModuleMetadatas>
        <DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis"/>
        <DependedModuleMetadata id="Native" order="LoadAfterThis" version="e1.5.*"/>
        <DependedModuleMetadata id="StoryMode" order="LoadAfterThis" optional="true"/>
    </DependedModuleMetadatas>
    -->
</Module>
