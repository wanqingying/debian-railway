{
  "$schema": "https://opencode.ai/config.json",
  "model": "commandcode/deepseek-v4-1-flash",
  "small_model": "commandcode/deepseek-v4-1-flash",
  "autoupdate": "notify",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false
