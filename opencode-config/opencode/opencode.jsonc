{
  "$schema": "https://opencode.ai/config.json",
  "model": "commandcode/deepseek-v4-flash",
  "small_model": "commandcode/deepseek-v4-flash",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "mdnsDomain": "opencode.local",
    "cors": [
      "http://localhost:5173"
    ]
  },
  "autoupdate": "notify",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ],
  "provider": {
    "commandcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1"
      },
      "env": [
        "COMMANDCODE_API_KEY"
      ],
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (latest)",
          "id": "deepseek/deepseek-v4-flash",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "mimo-v2-5": {
          "name": "MiMo V2.5",
          "id": "xiaomi/mimo-v2.5",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "mimo-v2-5-pro": {
          "name": "MiMo V2.5 Pro",
          "id": "xiaomi/mimo-v2.5-pro",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "minimax-m3": {
          "name": "MiniMax M3",
          "id": "MiniMaxAI/MiniMax-M3",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "glm-5-2": {
          "name": "GLM-5.2",
          "id": "zai-org/GLM-5.2",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "gemini-3-7-flash": {
          "name": "Gemini 3.7 Flash",
          "id": "google/gemini-3.7-flash",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "gemini-3-8-flash": {
          "name": "Gemini 3.8 Flash",
          "id": "google/gemini-3.8-flash",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "longcat-2-0-free": {
          "name": "LongCat 2.0 (free)",
          "id": "meituan/LongCat-2.0:free",
          "limit": { "context": 1000000, "output": 32768 },
          "tools": true
        },
        "laguna-s-2-1-free": {
          "name": "Laguna S 2.1 (free)",
          "id": "poolside/laguna-s-2.1-free",
          "limit": { "context": 256000, "output": 16384 },
          "tools": true
        }
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "disabled_providers": []
}
