{
  "$schema": "https://opencode.ai/config.json",
  "model": "commandcode/deepseek-v4-1-flash",
  "update": "notify",
  "agents": {
    "title": {
      "model": "commandcode/deepseek-v4-1-flash"
    },
    "summary": {
      "model": "commandcode/deepseek-v4-1-flash"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/node_modules/**",
      "dist/**",
      "**/dist/**",
      ".git/**",
      ".opencode/**",
      "**/*.db",
      "**/*.db-wal",
      "**/*.db-shm"
    ]
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  // New worktrees land on the mounted volume, not in the server's data dir and
  // certainly not in an ephemeral path. A worktree is a session's working
  // directory: /tmp, /root and the rest of the root filesystem are rebuilt from
  // the image on every redeploy, so a worktree created there disappears and its
  // session then fails with "Directory not found" and cannot be resumed.
  // Absolute, so it holds for every project regardless of where its checkout is.
  // Existing worktrees are not moved. Agents create worktrees with `wt`.
  "worktree": {
    "directory": "/workspace/worktrees"
  },
  "compaction": {
    "auto": false
  },
  "experimental": {
    "location_idle_timeout": false
  },
  // Pinned to an exact version, not @latest: the plugin owns the context window,
  // so a silent upstream swap changes every session's behaviour (and can strand a
  // long-running container on whatever it resolved first — opencode caches the
  // resolution and never re-resolves it). 0.49.21 is the oldest release that also
  // carries every OpenCode-2 fix we need: 0.49.17 added OpenCode 2.1.x support,
  // 0.49.21 fixed OpenCode 2 message search and stopped sending an empty part that
  // strict OpenAI-compatible providers (our `commandcode`) reject. 0.49.22/.23 only
  // touch Pi/Oh My Pi, so they are the same build for OpenCode with less soak.
  // Bump together with the prune in entrypoint.sh and the notes in AGENTS.md/README.
  "plugins": [
    "@cortexkit/opencode-magic-context@0.49.21"
  ],
  "providers": {
    "commandcode": {
      "name": "Command Code",
      "env": [
        "COMMANDCODE_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.commandcode.ai/provider/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "modelID": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (latest)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": {
              "read": 0.003
            }
          }
        },
        "mimo-v2-5": {
