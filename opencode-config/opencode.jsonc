{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "mdnsDomain": "opencode.local",
    "cors": [
      "http://localhost:5173"
    ]
  },
  "autoupdate": "notify",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ],
  "provider": {},
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "disabled_providers": []
}