{
  "$schema": "https://opencode.ai/config.json",
  "model": "commandcode/deepseek-v4-flash",
  "small_model": "commandcode/deepseek-v4-flash",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "mdnsDomain": "opencode.local",
    "cors": [
      "http://localhost:5173"
    ]
  },
  "autoupdate": "notify",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@latest",
    "commandcode-go-opencode-provider/server"
  ],
  "provider": {
    "commandcode": {
      "npm": "commandcode-go-opencode-provider",
      "name": "Command Code",
      "env": [
        "COMMANDCODE_API_KEY"
      ]
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "disabled_providers": []
}