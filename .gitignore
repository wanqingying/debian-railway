.cortexkit/
__pycache__/
*.pyc
.playwright-cli/
tmp/
node_modules/
data/*.db-wal
data/*.db-shm
.skill-workspace/

# image_generate default output
/generated/

# g2pW polyphone model cache: downloaded into the current directory by
# piper-tts on first synthesis (~159 MB ONNX + char tables). Scratch, and
# re-downloaded on demand.
/g2pW/

# vendor log dumps pulled by scripts/*-logs.mjs (a6api, gptge); ~0.5 MB each and
# regenerable, so they are scratch data, not part of the committed dataset
/data/*-logs.json

# Large binaries stay out of the repo: the fork builds moved to Cloudflare R2
# (BD-005 installs the official npm package) and *.pdf / the price catalogues
# are regenerated or downloadable. History before BD-005 still had them; a
# rewrite on 2026-11-27 purged them from every branch.
vendor/*.tgz
*.pdf
docs/models.dev.json
docs/models-prices.json
